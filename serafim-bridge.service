[Unit]
Description=Serafim R2+ Virtual Joystick Bridge
After=graphical-session.target
Wants=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /var/home/mente/.config/serafim-r2/serafim_virtual_joystick.py
Restart=on-failure
RestartSec=5
Environment="PYTHONUNBUFFERED=1"

[Install]
WantedBy=default.target